# Ключ Claude API (https://console.anthropic.com). Только на сервере, НЕ с префиксом NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Защита бюджета: общий лимит запросов к Финни в сутки и лимит на один IP в час
FINNI_DAILY_CAP=500
FINNI_HOURLY_PER_IP=40

# Supabase (пока не подключён в коде, см. supabase/schema.sql)
# Только origin, без /rest/v1: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Улучшенный голос Финни (необязательно). Без ключа Финни говорит голосом браузера.
# Ключ и голоса только на сервере. Иврит поддерживает модель eleven_v3 (multilingual_v2 иврит не поддерживает).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_HE=
ELEVENLABS_VOICE_RU=
ELEVENLABS_MODEL=eleven_v3
# Защита роута /api/tts: запросов в час на IP и на клиента, символов в сутки на клиента и всего
TTS_HOURLY_PER_IP=90
TTS_HOURLY_PER_CLIENT=60
TTS_CLIENT_DAILY_CHARS=6000
TTS_DAILY_CHAR_CAP=40000
